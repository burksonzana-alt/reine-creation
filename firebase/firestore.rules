rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catalogue partagé : tout le monde lit, seules les applis connectées écrivent.
    match /catalogue/{modele} {
      allow read: if true;
      allow write: if request.auth != null;
      match /photos/{photo} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
